DATABASE_URL=postgres://localhost:5432/takes_replies_test?sslmode=disable
AUTH_BEARER_TOKEN=replace-with-a-private-random-token
AUTH_USER_ID=test-owner
PORT=8080

# Optional. Without this key, storage/health/read routes work but model calls fail closed.
OPENROUTER_API_KEY=
REPLY_MODEL=anthropic/claude-sonnet-5.5
EVIDENCE_MODEL=google/gemini-3.8-flash
BASKET_MODEL=google/gemini-3.8-flash

# Source backend default for public availability reads.
HYPERLIQUID_DEXES=xyz
